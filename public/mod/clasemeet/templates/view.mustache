{{!
    @template mod_clasemeet/view

    Meet class page: join card and recordings list.

    Example context (json):
    {
        "name": "Cálculo I - Semana 3",
        "intro": "<p>Clase en vivo</p>",
        "hasspace": true,
        "meetinguri": "https://meet.google.com/abc-defg-hij",
        "meetingcode": "abc-defg-hij",
        "ownername": "Ana Pérez",
        "autorecording": true,
        "hasrecordings": true,
        "recordings": [
            {"date": "15/09/26 10:00", "duration": "1 hora 30 min", "state": "Lista", "ready": true,
             "exporturi": "https://drive.google.com/file/d/xyz/view", "shared": false}
        ],
        "canmanage": true,
        "syncurl": "#",
        "lastsync": "nunca",
        "attendance": {
            "rules": "Retraso si entra más de 10 min después del inicio; Falta si está conectado menos del 50 % del horario.",
            "enabled": true, "hasactivity": true, "taken": true,
            "takentext": "Registrada en la actividad Asistencia el 19/09/26.", "sessionurl": "#",
            "hasrows": true, "canapply": true, "applyurl": "#",
            "rows": [
                {"name": "Luis Quispe", "email": "lquispe@unamad.edu.pe", "identified": true, "profileurl": "#",
                 "firstjoin": "19:02", "lastleave": "21:00", "time": "1 hora 58 min", "percent": 98, "sessions": 1,
                 "result": "Presente", "resultclass": "bg-success"}
            ]
        }
    }
}}
<div class="clasemeet">
    {{{intro}}}

    {{#hasspace}}
    <div class="card mb-4">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-grow-1">
                {{#schedule}}
                <div class="fw-semibold mb-1">
                    <i class="fa fa-calendar me-1" aria-hidden="true"></i>{{schedule}}
                    {{#status}}<span class="badge {{statusclass}} ms-2">{{statustext}}</span>{{/status}}
                </div>
                {{/schedule}}
                <div class="text-muted small">{{#str}}owner, mod_clasemeet{{/str}}: {{ownername}}</div>
                <div class="text-muted small">{{#str}}meetingcode, mod_clasemeet{{/str}}: <code>{{meetingcode}}</code></div>
                {{#autorecording}}
                <div class="mt-2">
                    <span class="badge bg-danger"><i class="fa fa-circle me-1" aria-hidden="true"></i>{{#str}}recordingautomatic, mod_clasemeet{{/str}}</span>
                </div>
                {{/autorecording}}
            </div>
            <a class="btn btn-primary btn-lg" href="{{meetinguri}}" target="_blank" rel="noopener"
               title="{{#str}}opennewtab, mod_clasemeet{{/str}}">
                <i class="fa fa-video me-2" aria-hidden="true"></i>{{#str}}join, mod_clasemeet{{/str}}
            </a>
        </div>
    </div>
    {{/hasspace}}
    {{^hasspace}}
    <div class="alert alert-warning">{{#str}}errornospace, mod_clasemeet{{/str}}</div>
    {{/hasspace}}

    <h3 class="h4">{{#str}}recordings, mod_clasemeet{{/str}}</h3>
    {{#sharingnotice}}
    <div class="alert alert-warning small">
        <i class="fa fa-triangle-exclamation me-1" aria-hidden="true"></i>{{{sharingnotice}}}
    </div>
    {{/sharingnotice}}
    {{#hasrecordings}}
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>{{#str}}date, mod_clasemeet{{/str}}</th>
                    <th>{{#str}}duration, mod_clasemeet{{/str}}</th>
                    <th>{{#str}}status{{/str}}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#recordings}}
                <tr>
                    <td>{{date}}</td>
                    <td>{{duration}}</td>
                    <td>
                        {{state}}
                        {{#ready}}
                            {{#shared}}<span class="badge bg-success ms-1">{{#str}}shared, mod_clasemeet{{/str}}</span>{{/shared}}
                            {{^shared}}<span class="badge bg-secondary ms-1" title="{{#str}}notshared_help, mod_clasemeet{{/str}}">{{#str}}notshared, mod_clasemeet{{/str}}</span>{{/shared}}
                        {{/ready}}
                    </td>
                    <td class="text-end">
                        {{#ready}}
                        <a class="btn btn-outline-primary btn-sm" href="{{exporturi}}" target="_blank" rel="noopener">
                            <i class="fa fa-play me-1" aria-hidden="true"></i>{{#str}}watch, mod_clasemeet{{/str}}
                        </a>
                        {{/ready}}
                        {{^ready}}
                            {{#inprogress}}
                            <span class="text-danger small"><i class="fa fa-circle me-1" aria-hidden="true"></i>{{#str}}inprogress, mod_clasemeet{{/str}}</span>
                            {{/inprogress}}
                            {{^inprogress}}
                            <span class="text-muted small"><i class="fa fa-hourglass-half me-1" aria-hidden="true"></i>{{#str}}processing, mod_clasemeet{{/str}}</span>
                            {{/inprogress}}
                        {{/ready}}
                    </td>
                </tr>
                {{/recordings}}
            </tbody>
        </table>
    </div>
    {{/hasrecordings}}
    {{^hasrecordings}}
    <p class="text-muted">{{#str}}norecordings, mod_clasemeet{{/str}}</p>
    {{/hasrecordings}}

    {{#attendance}}
    <h3 class="h4 mt-4">{{#str}}attendance, mod_clasemeet{{/str}}</h3>
    <p class="text-muted small mb-2">{{rules}}</p>
    {{#enabled}}
        {{^hasactivity}}
        <div class="alert alert-info small">{{#str}}attendancenoactivity, mod_clasemeet{{/str}}</div>
        {{/hasactivity}}
        {{#hasactivity}}
            {{#taken}}
            <div class="alert alert-success small d-flex flex-wrap align-items-center gap-2">
                <span><i class="fa fa-check me-1" aria-hidden="true"></i>{{takentext}}</span>
                {{#sessionurl}}<a class="alert-link" href="{{sessionurl}}">{{#str}}attendanceview, mod_clasemeet{{/str}}</a>{{/sessionurl}}
            </div>
            {{/taken}}
            {{^taken}}
            <div class="alert alert-secondary small">{{#str}}attendancenotyet, mod_clasemeet{{/str}}</div>
            {{/taken}}
        {{/hasactivity}}
    {{/enabled}}
    {{#hasrows}}
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>{{#str}}moodleuser, mod_clasemeet{{/str}}</th>
                    <th>{{#str}}email, mod_clasemeet{{/str}}</th>
                    <th>{{#str}}firstjoin, mod_clasemeet{{/str}}</th>
                    <th>{{#str}}lastleave, mod_clasemeet{{/str}}</th>
                    <th>{{#str}}time, mod_clasemeet{{/str}}</th>
                    <th>{{#str}}percent, mod_clasemeet{{/str}}</th>
                    <th>{{#str}}result, mod_clasemeet{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                <tr>
                    <td>
                        {{#profileurl}}<a href="{{profileurl}}">{{name}}</a>{{/profileurl}}
                        {{^profileurl}}{{name}}{{/profileurl}}
                        {{^identified}}<span class="badge bg-secondary ms-1">{{#str}}notidentified, mod_clasemeet{{/str}}</span>{{/identified}}
                        {{#typelabel}}<span class="badge bg-light text-dark ms-1">{{typelabel}}</span>{{/typelabel}}
                        {{#meetname}}<div class="text-muted small">Meet: {{meetname}}</div>{{/meetname}}
                    </td>
                    <td class="small">{{email}}</td>
                    <td>{{firstjoin}}</td>
                    <td>
                        {{#connected}}<span class="text-success small"><i class="fa fa-circle me-1" aria-hidden="true"></i>{{#str}}connected, mod_clasemeet{{/str}}</span>{{/connected}}
                        {{^connected}}{{lastleave}}{{/connected}}
                    </td>
                    <td>{{time}}{{#sessions}} <span class="text-muted small" title="{{#str}}connections, mod_clasemeet{{/str}}">×{{sessions}}</span>{{/sessions}}</td>
                    <td>{{percent}} %</td>
                    <td>{{#result}}<span class="badge {{resultclass}}">{{result}}</span>{{/result}}</td>
                </tr>
                {{/rows}}
            </tbody>
        </table>
    </div>
    {{/hasrows}}
    {{^hasrows}}
    <p class="text-muted">{{#str}}noparticipants, mod_clasemeet{{/str}}</p>
    {{/hasrows}}
    {{#canapply}}
    <a class="btn btn-outline-primary btn-sm mb-2" href="{{applyurl}}"
       {{#taken}}title="{{#str}}attendanceapplyagain_help, mod_clasemeet{{/str}}"{{/taken}}>
        <i class="fa fa-clipboard-check me-1" aria-hidden="true"></i>
        {{#taken}}{{#str}}attendanceapplyagain, mod_clasemeet{{/str}}{{/taken}}
        {{^taken}}{{#str}}attendanceapply, mod_clasemeet{{/str}}{{/taken}}
    </a>
    {{/canapply}}
    {{/attendance}}

    {{#canmanage}}
    <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
        <a class="btn btn-outline-secondary" href="{{syncurl}}">
            <i class="fa fa-rotate me-1" aria-hidden="true"></i>{{#str}}sync, mod_clasemeet{{/str}}
        </a>
        <span class="text-muted small">{{#str}}lastsync, mod_clasemeet, {{lastsync}}{{/str}}</span>
    </div>
    {{/canmanage}}
</div>
